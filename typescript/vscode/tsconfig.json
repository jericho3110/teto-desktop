{
  // The extension host side: runs in VS Code's Node.js process, so CommonJS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "rootDir": ".",
    "outDir": "out/host",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src", "webview/messages.ts"]
}
