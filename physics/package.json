{
  "name": "teto-physics",
  "private": true,
  "version": "0.1.0",
  "description": "Spring-chain hair physics in freestanding C++, compiled to WebAssembly",
  "type": "module",
  "scripts": {
    "build": "clang++ --target=wasm32 -O2 -std=c++20 -nostdlib -fno-exceptions -fno-rtti -Wall -Wextra -Werror -Wl,--no-entry -Wl,--strip-all -o dist/physics.wasm src/exports.cpp",
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
